<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Surfaces -->
    <Color x:Key="Bg0Color">#0A0C11</Color>
    <Color x:Key="Bg1Color">#10131A</Color>
    <Color x:Key="Bg2Color">#161A23</Color>
    <Color x:Key="Bg3Color">#1D222D</Color>
    <Color x:Key="Bg4Color">#252B38</Color>
    <Color x:Key="LineColor">#232937</Color>
    <Color x:Key="Line2Color">#323A4B</Color>
    <Color x:Key="TextColor">#E8EBF1</Color>
    <Color x:Key="TextMutedColor">#8C94A6</Color>
    <Color x:Key="TextDimColor">#5A6277</Color>
    <Color x:Key="DangerColor">#FF5D6E</Color>
    <Color x:Key="WarningColor">#FFB547</Color>
    <Color x:Key="SuccessColor">#4ADE80</Color>

    <!-- Accent (replaced at runtime by ThemeManager) -->
    <Color x:Key="AccentColor">#3DD6F5</Color>
    <Color x:Key="AccentSoftColor">#2E3DD6F5</Color>
    <Color x:Key="AccentFaintColor">#123DD6F5</Color>
    <Color x:Key="OnAccentColor">#061015</Color>

    <SolidColorBrush x:Key="Bg0Brush" Color="{StaticResource Bg0Color}" />
    <SolidColorBrush x:Key="Bg1Brush" Color="{StaticResource Bg1Color}" />
    <SolidColorBrush x:Key="Bg2Brush" Color="{StaticResource Bg2Color}" />
    <SolidColorBrush x:Key="Bg3Brush" Color="{StaticResource Bg3Color}" />
    <SolidColorBrush x:Key="Bg4Brush" Color="{StaticResource Bg4Color}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="Line2Brush" Color="{StaticResource Line2Color}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#26FF5D6E" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#22FFB547" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="#3DD6F5" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2E3DD6F5" />
    <SolidColorBrush x:Key="AccentFaintBrush" Color="#123DD6F5" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#061015" />

    <!-- Controller artwork -->
    <SolidColorBrush x:Key="PadStrokeBrush" Color="#3B4458" />
    <SolidColorBrush x:Key="PadLeaderBrush" Color="#2F3747" />
    <LinearGradientBrush x:Key="PadBodyBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#1A1F2A" />
        <GradientStop Offset="1" Color="#0F1218" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="PadPartBrush" Color="#141821" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
</ResourceDictionary>
