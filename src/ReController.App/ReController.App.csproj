<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>reController</AssemblyName>
    <RootNamespace>ReController.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\reController.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WFAC010: DPI is configured in app.manifest for WPF. CA1001: App disposes its members in OnExit. -->
    <NoWarn>$(NoWarn);WFAC010;CA1001</NoWarn>
    <Title>reController</Title>
    <Description>Open-source controller remapper for Windows</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon; keep its types out of the global namespace. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\reController.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <!--
    Bundled drivers: the official signed ViGEmBus / HidHide installers are embedded in reController.exe so users
    never have to download anything. They are fetched (SHA-256 pinned, signature checked) into /redist on first build.
    Build with -p:SkipRedist=true to produce a smaller dev build without them (the app then links to the downloads).
  -->
  <PropertyGroup>
    <RedistDir>$(MSBuildThisFileDirectory)..\..\redist\</RedistDir>
  </PropertyGroup>
  <ItemGroup Condition="'$(SkipRedist)' != 'true'">
    <EmbeddedResource Include="$(RedistDir)ViGEmBus.exe" LogicalName="redist/ViGEmBus.exe" Visible="false" />
    <EmbeddedResource Include="$(RedistDir)HidHide.exe" LogicalName="redist/HidHide.exe" Visible="false" />
  </ItemGroup>
  <Target Name="FetchRedist" BeforeTargets="PrepareForBuild" Condition="'$(SkipRedist)' != 'true' And (!Exists('$(RedistDir)ViGEmBus.exe') Or !Exists('$(RedistDir)HidHide.exe'))">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\build\fetch-redist.ps1&quot; -Destination &quot;$(RedistDir.TrimEnd('\'))&quot;" />
  </Target>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReController.Core\ReController.Core.csproj" />
    <ProjectReference Include="..\ReController.Platform.Windows\ReController.Platform.Windows.csproj" />
  </ItemGroup>
</Project>
