<Window x:Class="ReController.App.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{StaticResource Bg1Brush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource Line2Brush}" BorderThickness="1">
        <StackPanel Margin="24,20,24,20">
            <TextBlock x:Name="TitleText" Style="{StaticResource H2}" Margin="0,0,0,10" />
            <TextBlock x:Name="MessageText" Style="{StaticResource Muted}" Margin="0,0,0,14" />
            <TextBox x:Name="InputBox" Margin="0,0,0,18" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="88" Click="OnCancel" />
                <Button x:Name="OkButton" Content="OK" IsDefault="True" MinWidth="88" Style="{StaticResource AccentButton}" Click="OnOk" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
