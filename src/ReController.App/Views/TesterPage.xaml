<UserControl x:Class="ReController.App.Views.TesterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ReController.App.ViewModels">
    <UserControl.Resources>
        <ItemsPanelTemplate x:Key="Wrap">
            <WrapPanel />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="Indicator" DataType="{x:Type vm:IndicatorViewModel}">
            <Border x:Name="Bd" MinWidth="52" Margin="0,0,6,6" Padding="8,7" CornerRadius="6" Background="{StaticResource Bg2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <TextBlock x:Name="T" Text="{Binding Name}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12.5" Foreground="{StaticResource TextDimBrush}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOn}" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="T" Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="Axis" DataType="{x:Type vm:AxisViewModel}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="60" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextMutedBrush}" FontSize="12.5" VerticalAlignment="Center" />
                <Grid Grid.Column="1" Height="10">
                    <Border Background="{StaticResource Bg2Brush}" CornerRadius="3" />
                    <Canvas>
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="3" Height="10" Canvas.Left="{Binding BarLeft}" Width="{Binding BarSize}" />
                    </Canvas>
                </Grid>
                <TextBlock Grid.Column="2" Text="{Binding Display}" FontFamily="{StaticResource MonoFont}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,8,10,8">
        <StackPanel>
            <Border Background="{DynamicResource AccentFaintBrush}" BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,14,14">
                <DockPanel>
                    <TextBlock Text="&#xE946;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Top" />
                    <TextBlock Style="{StaticResource Muted}" Foreground="{StaticResource TextBrush}">
                        Press every button on the controller. A button that never lights up under <Bold>Physical input</Bold> is not reaching Windows — map
                        another button to it on the Mapping page. <Bold>Virtual output</Bold> shows what games receive.
                    </TextBlock>
                </DockPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Margin="0,0,14,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PollRateText}" Foreground="{StaticResource TextDimBrush}" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="Physical input" Style="{StaticResource H2}" />
                        </DockPanel>
                        <TextBlock Text="{Binding SelectedDevice.DisplayName, FallbackValue='No controller'}" Foreground="{StaticResource TextMutedBrush}" Margin="0,-6,0,12" />
                        <ItemsControl ItemsSource="{Binding InputIndicators}" ItemsPanel="{StaticResource Wrap}" ItemTemplate="{StaticResource Indicator}" />
                        <ItemsControl ItemsSource="{Binding InputAxes}" ItemTemplate="{StaticResource Axis}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,14,14">
                    <StackPanel>
                        <TextBlock Text="Virtual output" Style="{StaticResource H2}" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding LiveStatus}" Foreground="{StaticResource TextMutedBrush}" Margin="0,-6,0,12" />
                        <ItemsControl ItemsSource="{Binding OutputIndicators}" ItemsPanel="{StaticResource Wrap}" ItemTemplate="{StaticResource Indicator}" />
                        <ItemsControl ItemsSource="{Binding OutputAxes}" ItemTemplate="{StaticResource Axis}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
