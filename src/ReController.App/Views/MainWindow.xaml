<Window x:Class="ReController.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ReController.App.Views"
        xmlns:vm="clr-namespace:ReController.App.ViewModels"
        xmlns:inf="clr-namespace:ReController.App.Infrastructure"
        Title="reController" Width="1180" Height="760" MinWidth="980" MinHeight="620"
        Background="{StaticResource Bg0Brush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" Icon="/Assets/reController.ico"
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <inf:BoolToVisibilityConverter x:Key="NotBoolVis" Invert="True" />
        <inf:NullToVisibilityConverter x:Key="NullVis" />
        <inf:EqualsConverter x:Key="Eq" />
        <inf:EqualsToVisibilityConverter x:Key="EqVis" />

        <Style x:Key="TabItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent">
                            <ContentPresenter Margin="14,9" VerticalAlignment="Center" />
                            <Border x:Name="Bar" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource AccentBrush}" Opacity="0" CornerRadius="1" Margin="10,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="Bar" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LayerItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="6" Padding="10,5" Background="{StaticResource Bg2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg3Brush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Background="{StaticResource Bg0Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ======================= Title bar ======================= -->
            <Grid Background="{StaticResource Bg0Brush}">
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Image Source="/Assets/logo.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="reController" Margin="10,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Background="{StaticResource Bg3Brush}" CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppVersion, StringFormat=v{0}}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ChromeButton}" FontSize="13" Content="&#xE700;" ToolTip="Toggle games panel" WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding ToggleSidebarCommand}" />
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMinimize" ToolTip="Minimise" />
                    <Button x:Name="MaxButton" Style="{StaticResource ChromeButton}" Content="&#xE922;" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMaximize" ToolTip="Maximise" />
                    <Button Style="{StaticResource ChromeCloseButton}" Content="&#xE8BB;" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnClose" ToolTip="Close" />
                </StackPanel>
            </Grid>

            <!-- ======================= Body ======================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Main column -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Margin="24,6,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Width="330" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedGame.Name, FallbackValue='No game'}" Style="{StaticResource H1}" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Grid Width="32" Height="32" Margin="6,0,0,0" ToolTip="Changes are saved automatically">
                                    <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" Foreground="{StaticResource TextDimBrush}" Visibility="{Binding HasPendingSave, Converter={StaticResource NotBoolVis}}" />
                                    <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding HasPendingSave, Converter={StaticResource BoolVis}}" />
                                </Grid>
                                <Button Style="{StaticResource IconButton}" Content="&#xE72D;" ToolTip="Export / share this game's profile" Command="{Binding ExportGameCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <ComboBox Width="200" ItemsSource="{Binding Slots}" SelectedIndex="{Binding SelectedSlot}" ToolTip="Controller slot. Hold the slot switch button + D-Pad to change slots on the controller.">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SlotItemViewModel}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Assigned}" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="120" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Content="Apply" Style="{StaticResource AccentButton}" Margin="8,0,0,0" MinWidth="76" Command="{Binding ApplyCommand}"
                                        ToolTip="Apply this config to the selected controller slot" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE894;" Margin="2,0,0,0" ToolTip="Clear this slot" Command="{Binding ClearSlotCommand}" />
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Layers}" SelectedIndex="{Binding SelectedLayer}" ItemContainerStyle="{StaticResource LayerItem}" Margin="0,10,0,4"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled" ToolTip="Layers: hold a Shift button to use a shift layer's mappings">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:LayerItemViewModel}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                                            <Ellipse Width="6" Height="6" Margin="6,0,0,0" VerticalAlignment="Center" Fill="{StaticResource TextDimBrush}"
                                                     Visibility="{Binding HasBindings, Converter={StaticResource BoolVis}}" ToolTip="Has mappings" />
                                            <Ellipse Width="6" Height="6" Margin="4,0,0,0" VerticalAlignment="Center" Fill="{StaticResource SuccessBrush}"
                                                     Visibility="{Binding IsLive, Converter={StaticResource BoolVis}}" ToolTip="Active right now" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>

                        <!-- Config tabs -->
                        <DockPanel Grid.Column="1" VerticalAlignment="Top" Margin="8,2,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="New config" Command="{Binding AddConfigCommand}" VerticalAlignment="Top" />
                            <ListBox ItemsSource="{Binding SelectedGame.Configs}" SelectedItem="{Binding SelectedConfig}" ItemContainerStyle="{StaticResource TabItem}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ConfigTabViewModel}">
                                        <StackPanel Orientation="Horizontal" Background="Transparent" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                            <StackPanel.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Rename" Command="{Binding RenameConfigCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="Duplicate" Command="{Binding DuplicateConfigCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="Delete" Command="{Binding DeleteConfigCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                </ContextMenu>
                                            </StackPanel.ContextMenu>
                                            <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" Margin="0,0,7,0" VerticalAlignment="Center"
                                                     Visibility="{Binding IsApplied, Converter={StaticResource BoolVis}}" ToolTip="Applied to the active slot" />
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Grid>

                    <!-- Driver banners -->
                    <StackPanel Grid.Row="1" Margin="24,4,16,0">
                        <Border Background="{StaticResource DangerSoftBrush}" CornerRadius="8" Padding="14,8" Margin="0,0,0,6" Visibility="{Binding ShowViGEmBanner, Converter={StaticResource BoolVis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Get ViGEmBus" Command="{Binding InstallViGEmCommand}" />
                                <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource DangerBrush}" Margin="0,0,10,0" />
                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"
                                           Text="{Binding ViGEmBannerText}" />
                            </DockPanel>
                        </Border>
                        <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="8" Padding="14,8" Visibility="{Binding ShowHidHideBanner, Converter={StaticResource BoolVis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="11" Command="{Binding DismissHidHideBannerCommand}" ToolTip="Dismiss" />
                                <Button DockPanel.Dock="Right" Content="Get HidHide" Margin="0,0,6,0" Command="{Binding InstallHidHideCommand}" />
                                <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{StaticResource WarningBrush}" Margin="0,0,10,0" />
                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"
                                           Text="Games may see both your real and the virtual controller (double input). Install HidHide to hide the real one." />
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- Pages -->
                    <Grid Grid.Row="2">
                        <Grid Visibility="{Binding PageIndex, Converter={StaticResource EqVis}, ConverterParameter=0}">
                            <Ellipse Width="760" Height="460" Fill="{DynamicResource AccentGlowBrush}" IsHitTestVisible="False" />
                            <v:GamepadDiagram Margin="12,4,12,0" />
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" FontSize="12" Foreground="{StaticResource TextDimBrush}"
                                       Text="Click any button or label to remap it · pressed buttons light up live" />
                        </Grid>
                        <v:SticksPage Visibility="{Binding PageIndex, Converter={StaticResource EqVis}, ConverterParameter=1}" />
                        <v:TesterPage Visibility="{Binding PageIndex, Converter={StaticResource EqVis}, ConverterParameter=2}" />
                        <v:GamePage Visibility="{Binding PageIndex, Converter={StaticResource EqVis}, ConverterParameter=3}" />
                    </Grid>

                    <!-- Footer -->
                    <Grid Grid.Row="3" Margin="16,6,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Border Background="{StaticResource Bg2Brush}" CornerRadius="10" Width="44" Height="44" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="22" Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                            <StackPanel Margin="10,0,14,0" VerticalAlignment="Center" MaxWidth="230">
                                <StackPanel Orientation="Horizontal" Visibility="{Binding HasDevice, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="{Binding SelectedDevice.DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="170" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="11" Content="&#xE70F;" ToolTip="Rename controller" Command="{Binding RenameDeviceCommand}" />
                                </StackPanel>
                                <TextBlock Text="No controller connected" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Visibility="{Binding HasDevice, Converter={StaticResource NotBoolVis}}" />
                                <TextBlock Text="{Binding LiveStatus}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                <ComboBox Margin="0,4,0,0" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="DisplayName" MinHeight="26" FontSize="12"
                                          Visibility="{Binding HasMultipleDevices, Converter={StaticResource BoolVis}}" />
                            </StackPanel>
                            <ToggleButton Style="{StaticResource PowerToggle}" IsChecked="{Binding RemapEnabled}" VerticalAlignment="Center" ToolTip="Turn remapping on or off for all controllers" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <RadioButton Style="{StaticResource DotRadio}" GroupName="page" ToolTip="Mapping" IsChecked="{Binding PageIndex, Converter={StaticResource Eq}, ConverterParameter=0}" />
                                <RadioButton Style="{StaticResource DotRadio}" GroupName="page" ToolTip="Sticks &amp; triggers" IsChecked="{Binding PageIndex, Converter={StaticResource Eq}, ConverterParameter=1}" />
                                <RadioButton Style="{StaticResource DotRadio}" GroupName="page" ToolTip="Live input" IsChecked="{Binding PageIndex, Converter={StaticResource Eq}, ConverterParameter=2}" />
                                <RadioButton Style="{StaticResource DotRadio}" GroupName="page" ToolTip="Game &amp; config" IsChecked="{Binding PageIndex, Converter={StaticResource Eq}, ConverterParameter=3}" />
                            </StackPanel>
                            <TextBlock Text="{Binding PageTitle}" HorizontalAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12,0,0,0">
                            <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings" Command="{Binding OpenSettingsCommand}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE946;" ToolTip="About" Command="{Binding OpenAboutCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- Sidebar -->
                <Border Grid.Column="1" Width="300" Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0"
                        Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource NotBoolVis}}">
                    <Grid>
                        <!-- Games list -->
                        <Grid Visibility="{Binding IsEditorOpen, Converter={StaticResource NotBoolVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="18,14,10,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE8B5;" ToolTip="Import profile" Command="{Binding ImportGameCommand}" />
                                <TextBlock Text="Games" Style="{StaticResource H2}" VerticalAlignment="Center" />
                            </DockPanel>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}" ItemContainerStyle="{StaticResource GameItem}" Padding="10,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:GameItemViewModel}">
                                        <DockPanel Background="Transparent" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding ExecutablesSummary}">
                                            <DockPanel.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="Rename" Command="{Binding RenameGameCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="Duplicate" Command="{Binding DuplicateGameCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="Export…" Command="{Binding ExportGameCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    <MenuItem Header="Delete" Command="{Binding DeleteGameCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                </ContextMenu>
                                            </DockPanel.ContextMenu>
                                            <Ellipse DockPanel.Dock="Right" Width="7" Height="7" VerticalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                     Visibility="{Binding IsApplied, Converter={StaticResource BoolVis}}" ToolTip="Applied to the selected controller" />
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13.5" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button Grid.Row="2" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Margin="10,6,10,12" Padding="12,9" Command="{Binding AddGameCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" Margin="0,0,10,0" />
                                    <TextBlock Text="Add game" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Mapping editor -->
                        <ContentControl Content="{Binding Editor}" Focusable="False" Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolVis}}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <v:BindingEditorView />
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </Grid>
                </Border>
            </Grid>

            <!-- ======================= Toast ======================= -->
            <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,84" CornerRadius="8" Padding="14,9" MaxWidth="560"
                    BorderThickness="1" Visibility="{Binding ToastText, Converter={StaticResource NullVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource Bg3Brush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="6,2" Margin="10,0,0,0" FontFamily="{StaticResource IconFont}" FontSize="10" Content="&#xE711;" Command="{Binding DismissToastCommand}" />
                    <TextBlock Text="{Binding ToastText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- ======================= Overlays ======================= -->
            <v:Overlays Grid.Row="1" Visibility="{Binding IsOverlayOpen, Converter={StaticResource BoolVis}}" />
        </Grid>
    </Border>
</Window>
