<UserControl x:Class="ReController.App.Views.SticksPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ReController.App.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <Style x:Key="Row" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style x:Key="RowValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="DockPanel.Dock" Value="Right" />
        </Style>

        <DataTemplate DataType="{x:Type vm:StickPanelViewModel}">
            <Border Style="{StaticResource Card}" Margin="0,0,14,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="200" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" Margin="0,0,0,12" />
                        <Grid Width="150" Height="150">
                            <Ellipse Fill="{StaticResource Bg2Brush}" Stroke="{StaticResource Line2Brush}" />
                            <Ellipse Width="{Binding OuterDiameter}" Height="{Binding OuterDiameter}" Stroke="{StaticResource TextDimBrush}" StrokeDashArray="3 3" />
                            <Ellipse Width="{Binding DeadzoneDiameter}" Height="{Binding DeadzoneDiameter}" Fill="{StaticResource DangerSoftBrush}" />
                            <Line X1="75" Y1="6" X2="75" Y2="144" Stroke="{StaticResource LineBrush}" />
                            <Line X1="6" Y1="75" X2="144" Y2="75" Stroke="{StaticResource LineBrush}" />
                            <Canvas>
                                <Ellipse Width="10" Height="10" Fill="{StaticResource TextDimBrush}" Canvas.Left="{Binding RawLeft}" Canvas.Top="{Binding RawTop}" ToolTip="Raw input" />
                                <Ellipse Width="10" Height="10" Fill="{DynamicResource AccentBrush}" Canvas.Left="{Binding OutLeft}" Canvas.Top="{Binding OutTop}" ToolTip="Processed output" />
                            </Canvas>
                        </Grid>
                        <TextBlock Text="{Binding Readout}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource TextDimBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="raw" FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="4,0,10,0" />
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="output" FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="4,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Mode" Style="{StaticResource Caption}" />
                        <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" Margin="0,6,0,4" />
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowValue}" Text="{Binding Deadzone, StringFormat=P0}" />
                            <TextBlock Style="{StaticResource RowLabel}" Text="Deadzone" ToolTip="Ignore small movements near the centre (stick drift)." />
                        </DockPanel>
                        <Slider Minimum="0" Maximum="0.5" Value="{Binding Deadzone}" SmallChange="0.01" LargeChange="0.05" />
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowValue}" Text="{Binding OuterDeadzone, StringFormat=P0}" />
                            <TextBlock Style="{StaticResource RowLabel}" Text="Saturation" ToolTip="Deflection at which output reaches 100%." />
                        </DockPanel>
                        <Slider Minimum="0.5" Maximum="1" Value="{Binding OuterDeadzone}" SmallChange="0.01" LargeChange="0.05" />
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowValue}" Text="{Binding AntiDeadzone, StringFormat=P0}" />
                            <TextBlock Style="{StaticResource RowLabel}" Text="Anti-deadzone" ToolTip="Minimum output once outside the deadzone, to cancel out a game's own deadzone." />
                        </DockPanel>
                        <Slider Minimum="0" Maximum="0.5" Value="{Binding AntiDeadzone}" SmallChange="0.01" LargeChange="0.05" />
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowValue}" Text="{Binding Curve, StringFormat={}{0:0.00}}" />
                            <TextBlock Style="{StaticResource RowLabel}" Text="Response curve" ToolTip="1.00 = linear. Higher values give finer control near the centre." />
                        </DockPanel>
                        <Slider Minimum="0.4" Maximum="3" Value="{Binding Curve}" SmallChange="0.05" LargeChange="0.25" />
                        <DockPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowValue}" Text="{Binding DirectionThreshold, StringFormat=P0}" />
                            <TextBlock Style="{StaticResource RowLabel}" Text="Direction threshold" ToolTip="How far the stick must move for a direction mapping (e.g. W/A/S/D) to fire." />
                        </DockPanel>
                        <Slider Minimum="0.15" Maximum="0.9" Value="{Binding DirectionThreshold}" SmallChange="0.01" LargeChange="0.05" />
                        <StackPanel Visibility="{Binding IsMouse, Converter={StaticResource BoolVis}}">
                            <DockPanel Style="{StaticResource Row}">
                                <TextBlock Style="{StaticResource RowValue}" Text="{Binding MouseSpeed, StringFormat={}{0:0} px/s}" />
                                <TextBlock Style="{StaticResource RowLabel}" Text="Mouse speed" />
                            </DockPanel>
                            <Slider Minimum="200" Maximum="5000" Value="{Binding MouseSpeed}" SmallChange="50" LargeChange="250" />
                        </StackPanel>
                        <WrapPanel Margin="0,10,0,0">
                            <CheckBox Content="Invert X" IsChecked="{Binding InvertX}" Margin="0,0,18,0" />
                            <CheckBox Content="Invert Y" IsChecked="{Binding InvertY}" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:TriggerPanelViewModel}">
            <Border Style="{StaticResource Card}" Margin="0,0,14,14">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" Margin="0,0,0,12" />
                    <Grid Width="220" HorizontalAlignment="Left" Height="30">
                        <Border Background="{StaticResource Bg2Brush}" CornerRadius="4" />
                        <Border Background="{StaticResource TextDimBrush}" CornerRadius="4" HorizontalAlignment="Left" Width="{Binding RawBar}" Height="12" VerticalAlignment="Top" Margin="0,2,0,0" ToolTip="Raw" />
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" HorizontalAlignment="Left" Width="{Binding OutputBar}" Height="12" VerticalAlignment="Bottom" Margin="0,0,0,2" ToolTip="Output" />
                        <Canvas>
                            <Rectangle Width="2" Height="30" Fill="{StaticResource WarningBrush}" Canvas.Left="{Binding ThresholdLeft}" ToolTip="Press threshold" />
                        </Canvas>
                    </Grid>
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Style="{StaticResource RowValue}" Text="{Binding Deadzone, StringFormat=P0}" />
                        <TextBlock Style="{StaticResource RowLabel}" Text="Deadzone" />
                    </DockPanel>
                    <Slider Minimum="0" Maximum="0.5" Value="{Binding Deadzone}" SmallChange="0.01" />
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Style="{StaticResource RowValue}" Text="{Binding MaxZone, StringFormat=P0}" />
                        <TextBlock Style="{StaticResource RowLabel}" Text="Full pull at" />
                    </DockPanel>
                    <Slider Minimum="0.5" Maximum="1" Value="{Binding MaxZone}" SmallChange="0.01" />
                    <DockPanel Style="{StaticResource Row}">
                        <TextBlock Style="{StaticResource RowValue}" Text="{Binding DigitalThreshold, StringFormat=P0}" />
                        <TextBlock Style="{StaticResource RowLabel}" Text="Press threshold" ToolTip="When the trigger is mapped to a button/key, it activates past this point (yellow marker)." />
                    </DockPanel>
                    <Slider Minimum="0.05" Maximum="0.95" Value="{Binding DigitalThreshold}" SmallChange="0.01" />
                    <CheckBox Style="{StaticResource Switch}" Content="Hair trigger (any pull = full pull)" IsChecked="{Binding HairTrigger}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,8,10,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ContentControl Content="{Binding LeftStick}" Focusable="False" />
            <ContentControl Grid.Column="1" Content="{Binding RightStick}" Focusable="False" />
            <ContentControl Grid.Row="1" Content="{Binding LeftTrigger}" Focusable="False" />
            <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding RightTrigger}" Focusable="False" />
        </Grid>
    </ScrollViewer>
</UserControl>
