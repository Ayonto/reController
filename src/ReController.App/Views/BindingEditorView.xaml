<UserControl x:Class="ReController.App.Views.BindingEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ReController.App.ViewModels"
             xmlns:m="clr-namespace:ReController.Core.Mapping;assembly=ReController.Core"
             xmlns:inf="clr-namespace:ReController.App.Infrastructure">
    <UserControl.Resources>
        <inf:EqualsConverter x:Key="Eq" />
        <inf:EqualsToVisibilityConverter x:Key="EqVis" />
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <Style x:Key="ChipItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{StaticResource Bg3Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg4Brush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ItemsPanelTemplate x:Key="Wrap">
            <WrapPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Margin="18,14,10,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="12" ToolTip="Close (Esc)" Command="{Binding CloseCommand}" />
                <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center">
                    <Run Text="Mapping ·" /> <Run Text="{Binding LayerName, Mode=OneWay}" />
                </TextBlock>
            </DockPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" Margin="0,2,0,8" TextTrimming="CharacterEllipsis" />
            <ItemsControl ItemsSource="{Binding SourceChips}" ItemsPanel="{StaticResource Wrap}" Visibility="{Binding HasSourceChips, Converter={StaticResource BoolVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:SourceChipViewModel">
                        <ToggleButton Style="{StaticResource Chip}" Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                      Command="{Binding DataContext.SelectSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Background="{StaticResource Bg2Brush}" CornerRadius="6" Padding="10,7" Margin="0,4,0,0">
                <DockPanel>
                    <TextBlock Text="&#xE8AB;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" FontSize="12.5" />
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,4,14,8">
            <StackPanel>
                <TextBlock Text="Action" Style="{StaticResource Caption}" Margin="0,8,0,8" />
                <WrapPanel>
                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="kind" Content="Unchanged" IsChecked="{Binding Kind, Converter={StaticResource Eq}, ConverterParameter=Default}" />
                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="kind" IsChecked="{Binding Kind, Converter={StaticResource Eq}, ConverterParameter=Gamepad}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,6,0" /><TextBlock Text="Gamepad" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="kind" IsChecked="{Binding Kind, Converter={StaticResource Eq}, ConverterParameter=Keyboard}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE765;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,6,0" /><TextBlock Text="Keyboard" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="kind" IsChecked="{Binding Kind, Converter={StaticResource Eq}, ConverterParameter=Mouse}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE962;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,6,0" /><TextBlock Text="Mouse" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="kind" Content="Shift layer" IsEnabled="{Binding CanShift}" ToolTip="Shift layers can only be assigned on the main layer."
                                 IsChecked="{Binding Kind, Converter={StaticResource Eq}, ConverterParameter=Shift}" />
                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="kind" Content="Disabled" IsChecked="{Binding Kind, Converter={StaticResource Eq}, ConverterParameter=Disabled}" />
                </WrapPanel>

                <!-- Default -->
                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="{Binding Kind, Converter={StaticResource EqVis}, ConverterParameter=Default}"
                           Text="The control behaves exactly like the physical button (on shift layers it inherits the main layer)." />

                <!-- Gamepad -->
                <StackPanel Visibility="{Binding Kind, Converter={StaticResource EqVis}, ConverterParameter=Gamepad}">
                    <TextBlock Text="Send to virtual controller" Style="{StaticResource Caption}" Margin="0,14,0,4" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8" Text="Pick one or more — several act as a combo pressed together." />
                    <ItemsControl ItemsSource="{Binding GamepadTargets}" ItemsPanel="{StaticResource Wrap}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:TargetChipViewModel">
                                <ToggleButton Style="{StaticResource Chip}" Content="{Binding Name}" ToolTip="{Binding ToolTip}" IsChecked="{Binding IsChecked}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Keyboard -->
                <StackPanel Visibility="{Binding Kind, Converter={StaticResource EqVis}, ConverterParameter=Keyboard}">
                    <TextBlock Text="Keys" Style="{StaticResource Caption}" Margin="0,14,0,8" />
                    <Border x:Name="CaptureBox" Focusable="True" Cursor="Hand" CornerRadius="8" Padding="12" MinHeight="64"
                            Background="{StaticResource Bg2Brush}" BorderThickness="1.5" FocusVisualStyle="{x:Null}"
                            MouseLeftButtonDown="OnCaptureClick" PreviewKeyDown="OnCaptureKeyDown" PreviewKeyUp="OnCaptureKeyUp" LostKeyboardFocus="OnCaptureLostFocus">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Keys}" ItemsPanel="{StaticResource Wrap}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:KeyChip">
                                        <Border Background="{StaticResource Bg4Brush}" BorderBrush="{StaticResource Line2Brush}" BorderThickness="1,1,1,3" CornerRadius="5" Padding="9,4,4,4" Margin="0,0,6,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                <Button Style="{StaticResource GhostButton}" Padding="4,1" Margin="4,0,0,0" FontFamily="{StaticResource IconFont}" FontSize="9" Content="&#xE711;"
                                                        Command="{Binding DataContext.RemoveKeyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding KeysPrompt}" Foreground="{StaticResource TextMutedBrush}" FontSize="12.5" />
                        </StackPanel>
                    </Border>
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" Text="Multiple keys are held together (e.g. Ctrl + Shift + R). Sent as scan codes for game compatibility." />
                </StackPanel>

                <!-- Mouse -->
                <StackPanel Visibility="{Binding Kind, Converter={StaticResource EqVis}, ConverterParameter=Mouse}">
                    <TextBlock Text="Mouse action" Style="{StaticResource Caption}" Margin="0,14,0,8" />
                    <ListBox ItemsSource="{Binding MouseOptions}" SelectedItem="{Binding SelectedMouse}" ItemContainerStyle="{StaticResource ChipItem}" ItemsPanel="{StaticResource Wrap}" DisplayMemberPath="Name" />
                </StackPanel>

                <!-- Shift -->
                <StackPanel Visibility="{Binding Kind, Converter={StaticResource EqVis}, ConverterParameter=Shift}">
                    <TextBlock Text="Shift layer" Style="{StaticResource Caption}" Margin="0,14,0,8" />
                    <ListBox ItemsSource="{Binding ShiftLayers}" SelectedItem="{Binding ShiftLayer}" ItemContainerStyle="{StaticResource ChipItem}" ItemsPanel="{StaticResource Wrap}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat=Shift {0}}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" Text="While this control is held, every other control uses the shift layer's mappings (unmapped ones fall back to the main layer). Choose Toggle below to latch it instead." />
                </StackPanel>

                <!-- Disabled -->
                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="{Binding Kind, Converter={StaticResource EqVis}, ConverterParameter=Disabled}"
                           Text="This control is ignored on this layer — useful for a faulty button that sends ghost presses." />

                <!-- Activation -->
                <StackPanel Visibility="{Binding ShowActivation, Converter={StaticResource BoolVis}}">
                    <TextBlock Text="Activation" Style="{StaticResource Caption}" Margin="0,18,0,8" />
                    <Border Background="{StaticResource Bg2Brush}" CornerRadius="7" Padding="3" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" GroupName="mode" Content="Hold" ToolTip="Active while held" IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter={x:Static m:ActivationMode.Hold}}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="mode" Content="Toggle" ToolTip="Press once to turn on, again to turn off" IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter={x:Static m:ActivationMode.Toggle}}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="mode" Content="Turbo" ToolTip="Rapid-fire while held" IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter={x:Static m:ActivationMode.Turbo}}" IsEnabled="{Binding CanTurbo}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="mode" Content="Auto-fire" ToolTip="Press once to start rapid-fire, again to stop" IsChecked="{Binding Mode, Converter={StaticResource Eq}, ConverterParameter={x:Static m:ActivationMode.ToggleTurbo}}" IsEnabled="{Binding CanTurbo}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Visibility="{Binding ShowTurbo, Converter={StaticResource BoolVis}}" Margin="0,12,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Text="{Binding TurboRate, StringFormat={}{0:0} / s}" />
                            <TextBlock Text="Rate" Foreground="{StaticResource TextMutedBrush}" />
                        </DockPanel>
                        <Slider Minimum="2" Maximum="30" Value="{Binding TurboRate}" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="18,8,18,14">
            <Button DockPanel.Dock="Right" Content="Done" Style="{StaticResource AccentButton}" MinWidth="84" Command="{Binding CloseCommand}" />
            <Button Content="Reset" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Command="{Binding ResetToDefaultCommand}" ToolTip="Restore the original behaviour of this control" />
        </DockPanel>
    </Grid>
</UserControl>
